<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="30dp"
        android:src="@drawable/icon_app_logo" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="脚踏风火轮  网上自由行"
        android:textColor="@color/color_clash_dark"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:text="邮箱"
        android:textSize="13sp" />
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_edit_text">
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edit_email"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="输入邮箱地址"
            android:inputType="textEmailAddress"
            android:paddingStart="12dp"
            android:textSize="13sp" />
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/mail_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:visibility="gone" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            style="@style/CommonTextLabel"
            android:layout_centerVertical="true"
            android:text="密码" />
        <TextView
            android:id="@+id/tv_forget_pwd"
            style="@style/CommonTextLabel"
            android:layout_alignParentEnd="true"
            android:paddingVertical="4dp"
            android:text="忘记密码?"
            android:textColor="@color/color_clash_light" />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_edit_text"
        app:errorEnabled="true">
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@id/cb_show_pwd"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="输入密码"
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:textSize="13sp" />
        <com.github.kr328.clash.design.view.CenteredCheckBox
            android:id="@+id/cb_show_pwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:button="@null"
            android:checked="false"
            android:drawableStart="@drawable/cb_password_stat"
            android:gravity="center" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <CheckBox
            android:id="@+id/cb_agree_tos"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp" />
        <TextView
            android:id="@+id/tv_pp_tos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="同意《隐私政策》及《用户协议》"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_login_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_common_btn"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:text="登  录"
        android:textColor="@color/white"
        android:textSize="18sp" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp">
        <TextView
            android:id="@+id/btn_enter_tourist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="游客进入"
            android:textColor="@color/color_clash_dark"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/btn_enter_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="新用户注册"
            android:textColor="@color/color_clash"
            android:textSize="16sp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="50dp"
        android:text="Copyright 2025 @ Bingo VPN"
        android:textColor="@color/color_666"
        android:textSize="12sp" />
</LinearLayout>