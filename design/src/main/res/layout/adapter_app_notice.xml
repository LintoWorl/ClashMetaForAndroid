<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="clicked"
            type="android.view.View.OnClickListener" />
        <import type="android.view.View" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_airplane_ticket">
        <!--<ImageView
            android:id="@+id/bg_notice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_airplane_ticket" />-->
        <ImageView
            android:id="@+id/iv_notice_icon"
            android:layout_width="@dimen/main_top_banner_height"
            android:layout_height="@dimen/main_top_banner_height"
            android:layout_marginVertical="20dp"
            android:layout_marginEnd="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/icon_notify_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/tv_notice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/iv_notice_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_notice_icon"
            tools:text="❗必读❗(点击阅读详情)" />
        <TextView
            android:id="@+id/tv_notice_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="3"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_notice_icon"
            app:layout_constraintEnd_toStartOf="@id/iv_notice_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_notice_title"
            tools:text="1) 有问题先看官网：App主界面左上角 \n2) 关掉App再重新打开，会看到最新公告 \n3) 我们的性价比极高，再不买您会后悔滴^_^ \n4) 线路逐步稳定，计划增加一些线路" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>